    {
      "name": "daily_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_logs\" (\"updated_at\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"date\" TEXT NOT NULL UNIQUE, \"weight_kg\" REAL NULL, \"height_cm\" REAL NULL, \"fat_percentage\" REAL NULL, \"water_ml_raw\" INTEGER NOT NULL DEFAULT 0, \"water_ml_credit\" REAL NOT NULL DEFAULT 0.0, \"protein_g\" REAL NOT NULL DEFAULT 0.0, \"creatine_g\" REAL NOT NULL DEFAULT 0.0, \"mental_state\" TEXT NULL, \"body_feeling\" TEXT NULL, \"braces_used\" TEXT NOT NULL DEFAULT '[]', \"brace_comfort\" INTEGER NULL, \"steps\" INTEGER NOT NULL DEFAULT 0, \"is_rest_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_rest_day\" IN (0, 1)), \"is_flare_day\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_flare_day\" IN (0, 1)), \"sleep_hours\" REAL NULL, \"sleep_quality\" TEXT NULL, \"sleep_heart_rate_min\" INTEGER NULL, \"sleep_heart_rate_max\" INTEGER NULL, \"resting_heart_rate\" INTEGER NULL, \"hrv_ms\" REAL NULL, \"steps_source\" TEXT NULL, \"sleep_source\" TEXT NULL, \"heart_source\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "activities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activities\" (\"updated_at\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"activity_name\" TEXT NOT NULL, \"duration_min\" INTEGER NOT NULL, \"extra_weight_kg\" REAL NOT NULL DEFAULT 0.0, \"mental_state\" TEXT NULL, \"body_feeling\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"healthkit_uuid\" TEXT NULL UNIQUE, \"mets_avg\" REAL NULL, \"active_energy_kcal\" REAL NULL, \"heart_rate_min_bpm\" INTEGER NULL, \"heart_rate_max_bpm\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "calisthenics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"calisthenics\" (\"updated_at\" TEXT NOT NULL, \"deleted_at\" INTEGER NULL, \"id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"exercise\" TEXT NOT NULL, \"progression\" TEXT NOT NULL, \"sets\" INTEGER NOT NULL, \"reps\" INTEGER NOT NULL, \"comfort_score\" REAL NOT NULL DEFAULT 0.0, \"mental_state\" TEXT NULL, \"body_feeling\" TEXT NULL, \"contraction_mode\" TEXT NULL, \"heart_rate_min_bpm\" INTEGER NULL, \"heart_rate_max_bpm\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "therapies",
      "sql": [
        {
          "dialect": "sqlite",
