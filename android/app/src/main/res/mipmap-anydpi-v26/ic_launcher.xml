<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (minSdk 26, so every launcher uses this). The foreground
     is the artwork cropped and scaled to fill the launcher's mask; the
     legacy ic_launcher.png carried the iOS icon's wide white margin and
     showed up small inside the circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
